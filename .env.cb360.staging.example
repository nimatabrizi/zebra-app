# Template for CB360 Staging integration tests (safe to commit).
# Copy to .env.cb360.staging.local and fill the service_role key locally.
#
#   cp .env.cb360.staging.example .env.cb360.staging.local
#
# Then open .env.cb360.staging.local and set CB360_STAGING_SERVICE_ROLE_KEY
# from Supabase Dashboard → Project Settings → API → service_role.
# Do not commit .env.cb360.staging.local. Do not use production keys.

CB360_INTEGRATION=1
CB360_TARGET_ENV=staging
CB360_ALLOW_LIVE_DB=staging-only

# Runtime fail-closed (Preview/API): must match NEXT_PUBLIC_SUPABASE_URL host ref
CB360_ALLOWED_SUPABASE_REF=noagxyztimvefmewjybj

CB360_STAGING_PROJECT_REF=noagxyztimvefmewjybj
CB360_STAGING_SUPABASE_URL=https://noagxyztimvefmewjybj.supabase.co
CB360_STAGING_SERVICE_ROLE_KEY=

# CB360_FORBIDDEN_PROJECT_REFS=
