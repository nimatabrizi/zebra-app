{
  "name": "zebra-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:cb360": "tsx --test lib/cb360/__tests__/cb360.mock.test.ts lib/cb360/__tests__/cb360.runtimeGuard.test.ts",
    "test:cb360:integration": "tsx --test lib/cb360/__tests__/cb360.integration.test.ts",
    "test:cb360:integration:staging": "tsx --env-file=.env.cb360.staging.local --test lib/cb360/__tests__/cb360.integration.test.ts",
    "test:cb360:pg-contract": "tsx --test lib/cb360/__tests__/cb360.pg-contract.test.ts",
    "test:cb360:all-offline": "tsx --test lib/cb360/__tests__/cb360.mock.test.ts lib/cb360/__tests__/cb360.runtimeGuard.test.ts lib/cb360/__tests__/cb360.pg-contract.test.ts lib/cb360/__tests__/cb360.integration.test.ts lib/cb360/__tests__/cb360.previewE2eCleanup.test.ts",
    "migrate:auth": "node scripts/migrate-auth-users.mjs",
    "upload:consultant-photos": "node scripts/upload-consultant-photos.mjs",
    "ivo:worker": "node scripts/ivo-listing-worker.mjs",
    "ivo:worker:loop": "node scripts/ivo-listing-worker.mjs --loop",
    "ivo:sync": "node scripts/ivo-sync.mjs",
    "build:status-overlays": "bash scripts/build-status-overlays.sh",
    "setup:ffmpeg": "mkdir -p public/ffmpeg && cp node_modules/@ffmpeg/core/dist/esm/ffmpeg-core.js node_modules/@ffmpeg/core/dist/esm/ffmpeg-core.wasm public/ffmpeg/ && cp node_modules/@ffmpeg/ffmpeg/dist/esm/worker.js node_modules/@ffmpeg/ffmpeg/dist/esm/const.js node_modules/@ffmpeg/ffmpeg/dist/esm/errors.js public/ffmpeg/"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^1.0.1",
    "lucide-react": "^1.24.0",
    "next": "^16.3.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "fontkit": "^2.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
