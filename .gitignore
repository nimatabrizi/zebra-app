# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.cb360.staging.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tools
/scripts/.models/
/scripts/.venv/
/.tmp/

# CB360 Preview HTTP E2E session trackers (ids/paths only; never commit)
.cb360-preview-e2e/

# Local Rakip inventory snapshots (may contain professional identifiers; never commit)
.rakip-local/
